async def is_user_joined(user_id: int, context: ContextTypes.DEFAULT_TYPE) -> bool:
    if is_owner(user_id):
        return True
    for ch in config.REQUIRED_CHANNELS:
        try:
            member = await context.bot.get_chat_member(chat_id=ch["username"], user_id=user_id)
            if member.status in ("left", "kicked", "banned"):
                return False
        except BadRequest as e:
            if "Chat not found" in str(e):
                logger.warning(f"Channel {ch['username']} not found, skipping join check")
                continue
            logger.warning(f"get_chat_member failed for {ch['username']}: {e}")
            return False
        except Exception as e:
            logger.warning(f"get_chat_member exception for {ch['username']}: {e}")
            return False
    return True

