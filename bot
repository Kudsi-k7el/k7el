def sexy(text: str) -> str:
    bold_map = {}
    for i in range(26):
        bold_map[chr(65+i)] = chr(0x1D400 + i)
        bold_map[chr(97+i)] = chr(0x1D41A + i)
    for i in range(10):
        bold_map[chr(48+i)] = chr(0x1D7CE + i)
    out = ""
    for ch in text:
        out += bold_map.get(ch, ch)
    return out

