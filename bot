async def cmd_key(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    if not is_owner(user_id):
        await update.message.reply_text(f"{pe('❌')} Only owner can generate keys.")
        return
    args = context.args
    if len(args) != 3:
        await update.message.reply_text(
            f"{pe('❌')} Usage: <code>/key &lt;plan&gt; &lt;days&gt; &lt;count&gt;</code>\n"
            f"Example: <code>/key max 1 1</code> → 1 max key for 1 day\n"
            f"Example: <code>/key pro 30 5</code> → 5 pro keys for 30 days\n"
            f"Plans: <code>free</code>, <code>pro</code>, <code>max</code> | days &gt;0 | count 1-20",
            parse_mode="HTML"
        )
        return
    plan_raw, days_raw, count_raw = args
    plan = plan_raw.lower().strip()
    if plan not in config.VALID_PLANS:
        await update.message.reply_text(f"{pe('❌')} Invalid plan <code>{html.escape(plan)}</code>. Use: free, pro, max", parse_mode="HTML")
        return
    try:
        days = int(days_raw)
        count = int(count_raw)
    except ValueError:
        await update.message.reply_text(f"{pe('❌')} <code>days</code> and <code>count</code> must be integers.", parse_mode="HTML")
        return
    if days <= 0:
        await update.message.reply_text(f"{pe('❌')} <code>days</code> must be &gt;0")
        return
    if count < 1 or count > config.MAX_KEYS_PER_COMMAND:
        await update.message.reply_text(f"{pe('❌')} <code>count</code> must be 1-{config.MAX_KEYS_PER_COMMAND}")
        return
    try:
        keys = await asyncio.to_thread(database.generate_keys, plan, days, count, user_id)
    except Exception as e:
        logger.exception("generate_keys failed")
        await update.message.reply_text(f"{pe('❌')} Failed to generate keys: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
        return
    header = f"{pe('✅')} <b>Generated {count} key(s)</b> — Plan: <code>{html.escape(plan)}</code> | Duration: <code>{days}</code> day(s) | <i>Forever until redeemed</i>\n\n"
    keys_text = "\n".join(f"<code>{html.escape(k)}</code>" for k in keys)
    if count <= 5:
        msg = header + keys_text + f"\n\n<i>Share each key with</i> <code>/redeem &lt;key&gt;</code>"
        await update.message.reply_text(msg, parse_mode="HTML")
    else:
        preview = "\n".join(f"<code>{html.escape(k)}</code>" for k in keys[:5])
        msg = header + preview + f"\n<i>... and {count-5} more (see file)</i>"
        await update.message.reply_text(msg, parse_mode="HTML")
        tmp = tempfile.NamedTemporaryFile(mode="w", delete=False, suffix=".txt", encoding="utf-8")
        try:
            tmp.write(f"# KRAZY BOT Keys — Plan: {plan} | Duration: {days} days | Generated: {datetime.utcnow().isoformat()} UTC\n")
            tmp.write(f"# Owner: {user_id}\n\n")
            for k in keys:
                tmp.write(f"{k}\n")
            tmp.close()
            await context.bot.send_document(
                chat_id=update.effective_chat.id,
                document=open(tmp.name, "rb"),
                filename=f"krazy_keys_{plan}_{days}d_{count}.txt",
                caption=f"{pe('💎')} All {count} keys — {html.escape(plan)} {days}d"
            )
        finally:
            try:
                os.unlink(tmp.name)
            except:
                pass

