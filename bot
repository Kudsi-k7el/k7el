async def run_tool_checker(account_lines, chat_id, context: ContextTypes.DEFAULT_TYPE):
    status_msg = await context.bot.send_message(chat_id=chat_id, text="⚡ **[KUDASAI]** Preparing encrypted tool execution...")

    # Record files existing before tool execution
    files_before = set(os.listdir("."))

    # Save incoming accounts into 'accounts.txt' (standard input format for tools)
    with open("accounts.txt", "w", encoding="utf-8") as f:
        for line in account_lines:
            f.write(line.strip() + "\n")

    await status_msg.edit_text("⚡ **[KUDASAI]** Running tool engine in background... Please wait.")

    # Execute the obfuscated tool and capture both stdout and stderr
    stdout_output = ""
    stderr_output = ""
    try:
        process = subprocess.Popen(
            ["python3", ".ninjapy"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        stdout_output, stderr_output = process.communicate(timeout=300) # 5 min timeout max
    except Exception as e:
        stderr_output = str(e)

    await status_msg.edit_text("🎯 **[KUDASAI]** Execution finished. Collecting results...")

    sent_any = False

    # 1. Check if the tool printed valid output logs directly to the console (stdout)
    if stdout_output and len(stdout_output.strip()) > 0:
        log_path = os.path.join(OUTPUT_DIR, "tool_console_output.txt")
        with open(log_path, "w", encoding="utf-8") as f:
            f.write(stdout_output)
        if stderr_output:
            f.write("\n--- ERRORS ---\n" + stderr_output)
            
        with open(log_path, "rb") as f:
            await context.bot.send_document(chat_id=chat_id, document=f, caption="📁 Tool Console Output Log")
        sent_any = True
        try:
            os.remove(log_path)
        except Exception:
            pass

    # 2. Scan for any new or modified files generated by the tool execution
    files_after = set(os.listdir("."))
    new_files = files_after - files_before

    for filename in new_files:
        if filename.endswith((".txt", ".log", ".json", ".csv")) and filename != "accounts.txt" and filename != "bot_database.db":
            if os.path.exists(filename) and os.path.getsize(filename) > 0:
                with open(filename, "rb") as f:
                    await context.bot.send_document(chat_id=chat_id, document=f, caption=f"📁 Generated Output: {filename}")
                sent_any = True
                try:
                    os.remove(filename)
                except Exception:
                    pass

    # 3. Fallback check for standard names
    for fallback in ["results.txt", "2fa.txt", "errors.txt", "hits.txt", "valid.txt", "checked.txt"]:
        if os.path.exists(fallback) and os.path.getsize(fallback) > 0:
            with open(fallback, "rb") as f:
                await context.bot.send_document(chat_id=chat_id, document=f, caption=f"📁 Output: {fallback}")
            sent_any = True
            try:
                os.remove(fallback)
            except Exception:
                pass

    # Cleanup accounts input file
    if os.path.exists("accounts.txt"):
        try:
            os.remove("accounts.txt")
        except Exception:
            pass

    if not sent_any:
        await context.bot.send_message(
            chat_id=chat_id, 
            text="ℹ️ Tool executed successfully, but no output files or console prints were captured. Make sure your encrypted tool is configured to write results to files or print them out."
        )

