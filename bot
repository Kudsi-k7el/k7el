async def start_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    db_query("INSERT OR IGNORE INTO users (user_id, username, expiry) VALUES (?, ?, ?)", (user.id, user.username or "Unknown", datetime.now().isoformat()))
    user_data = db_query("SELECT is_banned, expiry FROM users WHERE user_id=?", (user.id,), "one")
    if user_data and user_data[0] == 1:
        if update.message: await update.message.reply_text("❌ Banned.")
        return
    expiry_dt = datetime.fromisoformat(user_data[1]) if user_data and user_data[1] else datetime.now()
    has_access = expiry_dt > datetime.now() or user.id in ADMIN_IDS
    access_status = f"✅ Active until {expiry_dt.strftime('%m-%d %H:%M')}" if has_access else "❌ No Active Key"

    gui_text = f"✨ **KUDASAI XBOX CHECKER** ✨\n\n🔒 Access: {access_status}\n\nUse buttons below:"
    if update.message: await update.message.reply_text(gui_text, parse_mode="Markdown", reply_markup=get_main_menu(user.id))
    elif update.callback_query: await update.callback_query.message.edit_text(gui_text, parse_mode="Markdown", reply_markup=get_main_menu(user.id))

