async def add_acc_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    if user.id not in ADMIN_IDS:
        await update.message.reply_text("❌ This command is for admins only!")
        return

    text = update.message.text
    parts = text.split(maxsplit=1)
    if len(parts) < 2:
        await update.message.reply_text("⚠️ Correct usage:\n`/addacc <cookies>`", parse_mode="Markdown")
        return

    cookie_text = parts[1].strip()
    status_msg = await update.message.reply_text("⏳ <i>Verifying account and adding to database...</i>", parse_mode="HTML")

    cookies = load_cookies(cookie_text)
    if not cookies or not any(cookies.get(k) for k in ["NetflixId", "SecureNetflixId"]):
        await status_msg.edit_text("❌ <b>Error:</b> No valid Netflix cookies found.", parse_mode="HTML")
        return

    acc = await asyncio.to_thread(check_account, cookies, 20)
    if not acc:
        await status_msg.edit_text("❌ <b>Error:</b> Account is dead or invalid, cannot be added.", parse_mode="HTML")
        return

    db_query("INSERT INTO accounts (cookies, added_by) VALUES (?, ?)", (cookie_text, user.id))

    await status_msg.edit_text(
        f"✅ <b>Account successfully added to stock!</b>\n\n"
        f"📧 Email: <code>{acc['email']}</code>\n"
        f"📋 Plan: <b>{acc['plan']}</b>\n"
        f"🌍 Country: {acc['country']} ({acc['country_code']})",
        parse_mode="HTML"
    )

