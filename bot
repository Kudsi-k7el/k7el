def parse_combos_from_text(text: str):
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    combos = []
    seen = set()
    for line in lines:
        s = line.strip()
        if not s:
            continue
        if s.startswith("#"):
            continue
        if ":" not in s:
            continue
        if s not in seen:
            seen.add(s)
            combos.append(s)
    return combos

