def pe(char: str) -> str:
    lookup = EMOJI_FALLBACK.get(char, char)
    eid = PREMIUM_IDS.get(lookup)
    if not eid:
        eid = PREMIUM_IDS.get(char)
        lookup = char
    if eid:
        return f'<tg-emoji emoji-id="{eid}">{lookup}</tg-emoji>'
    return char

def is_owner(user_id: int) -> bool:
    return user_id == config.OWNER_ID

def get_user_limits(user_id: int, checker_type="hotmail"):
    plan, expires_at, was_expired = database.get_user_plan(user_id)
    if checker_type == "xbox":
        limit = config.TIER_XBOX_LIMITS.get(plan, 1000)
        threads = config.TIER_XBOX_THREADS.get(plan, 5)
    elif checker_type == "xboxapi":
        limit = config.TIER_XBOX_LIMITS.get(plan, 1000)
        threads = config.TIER_XBOXAPI_THREADS.get(plan, 10)
    elif checker_type == "inbox":
        limit = config.TIER_HOTMAIL_LIMITS.get(plan, 2000)
        threads = config.TIER_INBOX_THREADS.get(plan, 5)
    elif checker_type == "steam":
        limit = config.TIER_STEAM_LIMITS.get(plan, 1000)
        threads = config.STEAM_THREADS
    else:
        limit = config.TIER_HOTMAIL_LIMITS.get(plan, 2000)
        threads = config.TIER_THREADS.get(plan, 20)
    return plan, limit, threads, expires_at

