async def button_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user_id = query.from_user.id
    data = query.data

    db_query("INSERT OR IGNORE INTO users (user_id, username) VALUES (?, ?)", (user_id, query.from_user.username or "Unknown"))

    if data == "check_membership":
        is_ch, is_gp = await check_memberships(context.bot, user_id)
        if not is_ch or not is_gp:
            await query.answer("❌ You have not joined both the channel and group yet!", show_alert=True)
            return
        await query.answer("✅ Memberships verified successfully!", show_alert=False)
        await start_command(update, context)
        return

    is_ch, is_gp = await check_memberships(context.bot, user_id)
    if not is_ch or not is_gp:
        join_text = (
            "🚨 **Channel & Group Subscription Required!**\n\n"
            f"Please join both our channel ({REQUIRED_CHANNEL}) and group ({REQUIRED_GROUP}) first."
        )
        await query.message.edit_text(join_text, parse_mode="Markdown", reply_markup=get_join_menu())
        return

    if data == "main_menu":
        await start_command(update, context)
    elif data == "check_prompt":
        await query.message.edit_text(
            "🍪 **Send Netflix Cookies**\n\n"
            "Please paste your Netscape cookies, JSON, or cookie text directly in the chat now:",
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("❌ Cancel", callback_data="main_menu")]]))
    elif data == "get_nftoken":
        # Fixed callback routing to safely call nftoken_command
        await nftoken_command(update, context)
    elif data == "check_status":
        user_data = db_query("SELECT checks_count FROM users WHERE user_id=?", (user_id,), "one")
        total = user_data["checks_count"] if user_data else 0
        total_users = len(db_query("SELECT user_id FROM users", fetch="all"))
        stock_count = len(db_query("SELECT id FROM accounts", fetch="all"))

        await query.message.edit_text(
            f"📊 **Your Account Status:**\n\n"
            f"🆔 Telegram ID: `{user_id}`\n"
            f"📈 Total Checks Performed: `{total}`\n"
            f"👥 Total Bot Users: `{total_users} users`\n"
            f"📦 Available Stock Accounts: `{stock_count} accounts`",
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="main_menu")]]))
    elif data == "guide":
        guide_msg = (
            "📖 **User Guide:**\n\n"
            "1. Click **Get Account (/nftoken)** to instantly receive a verified active Netflix account.\n"
            "2. Or click **Check Netflix Cookie** to check your own custom cookies.\n\n"
            f"➡️ Owner: {OWNER_HANDLE}"
        )
        await query.message.edit_text(guide_msg, parse_mode="Markdown", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="main_menu")]]))
    elif data == "admin_panel":
        if user_id not in ADMIN_IDS: return
        users_count = len(db_query("SELECT user_id FROM users", fetch="all"))
        stock_count = len(db_query("SELECT id FROM accounts", fetch="all"))
        
        await query.message.edit_text(
            f"⚙️ **ADMIN CONTROL PANEL**\n\n"
            f"👥 Total Registered Users: `{users_count}`\n"
            f"📦 Accounts in Stock: `{stock_count}`\n"
            f"🛡️ Commands: Use `/addacc <cookies>` to add accounts.",
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back to Main Menu", callback_data="main_menu")]]))

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    text = update.message.text
    if not text or text.startswith("/"):
        return

    db_query("INSERT OR IGNORE INTO users (user_id, username) VALUES (?, ?)", (user.id, user.username or "Unknown"))

    is_ch, is_gp = await check_memberships(context.bot, user.id)
    if not is_ch or not is_gp:
        await update.message.reply_text(
            "🚨 **Channel & Group Subscription Required!**\n\n"
            f"Please join both our channel ({REQUIRED_CHANNEL}) and group ({REQUIRED_GROUP}) first before using the bot.",
            parse_mode="Markdown",
            reply_markup=get_join_menu()
        )
        return

    is_admin = user.id in ADMIN_IDS
    status_msg = await update.message.reply_text("⏳ <i>Processing cookies in queue...</i>", parse_mode="HTML")

    try:
        cookies = load_cookies(text)
        if not cookies or not any(cookies.get(k) for k in ["NetflixId", "SecureNetflixId"]):
            await status_msg.edit_text("❌ <b>Error:</b> Could not detect valid Netflix cookies (`NetflixId` / `SecureNetflixId`).", parse_mode="HTML")
            return

        if is_admin:
            acc = await asyncio.to_thread(check_account, cookies, 20)
        else:
            async with CHECK_SEMAPHORE:
                await status_msg.edit_text("⏳ <i>Your request has left the queue and is now checking...</i>", parse_mode="HTML")
                acc = await asyncio.to_thread(check_account, cookies, 20)

        if not acc:
            await status_msg.edit_text("❌ <b>Error:</b> Account is dead, logged out, or cookies are expired/invalid.", parse_mode="HTML")
            return

        db_query("UPDATE users SET checks_count = checks_count + 1 WHERE user_id=?", (user.id,))

        cc = acc.get("country_code", "XX")
        flag = _flag(cc)
        p = acc.get("profiles", [])
        profs = ", ".join(p[:4]) if p else "N/A"
        pv = "✅" if acc.get("phone_verified") else "❌"
        nf_id = acc.get("netflix_id_raw", "")

        caption = (
            f"🎬 <b>NETFLIX ACCOUNT FOUND</b>\n\n"
            f"👤 <b>{acc['name']}</b>\n"
            f"📧 <code>{acc['email']}</code>\n"
            f"🌍 {acc['country']} {flag} ({cc})\n\n"
            f"📋 <b>{acc['plan']}</b>  •  💰 {acc['price']}\n"
            f"📅 Since: {acc['member_since']}\n"
            f"🗓 Billing: {acc['next_billing']}\n"
            f"🎁 Free Trial: {'Yes' if acc['free_trial'] else 'No'}\n\n"
            f"🎥 {acc['video_quality']}  |  📺 {acc['max_streams']} streams  |  ➕ {acc['extra_slots']} extra\n"
            f"💳 {acc['card_brand']} *{acc['card_last4']}  •  {acc['payment_method']}\n"
            f"📞 {acc['phone']}  {pv}\n"
            f"👥 Profiles ({acc['profile_count']}): {profs}\n\n"
            f"🍪 <b>Cookie Snippet</b>\n"
            f"<code>NetflixId={nf_id[:30]}...</code>\n\n"
            f"➖➖➖➖➖➖➖➖➖➖\n"
            f"➡️ <b>Developer:</b> {OWNER_HANDLE}\n"
            f"🤖 <b>Bot:</b> {BOT_HANDLE}"
        )

        buttons = []
        row1 = []
        if acc.get("login_pc") and acc["login_pc"] != "N/A":
            row1.append(InlineKeyboardButton("🖥 Click to PC", url=acc["login_pc"]))
        if acc.get("login_phone") and acc["login_phone"] != "N/A":
            row1.append(InlineKeyboardButton("📱 Click to Phone", url=acc["login_phone"]))
        if row1:
            buttons.append(row1)
        buttons.append([InlineKeyboardButton("📺 Click to TV", url=acc["login_tv"])])

        reply_markup = InlineKeyboardMarkup(buttons)
        await status_msg.edit_text(caption, parse_mode="HTML", reply_markup=reply_markup)

    except Exception as e:
        print(f"[DEBUG] Checker Exception: {e}")
        await status_msg.edit_text(f"❌ <b>An error occurred:</b> <code>{str(e)}</code>", parse_mode="HTML")

def main():
    app = ApplicationBuilder().token(TELEGRAM_BOT_TOKEN).post_init(set_bot_commands).build()

    app.add_handler(CommandHandler("start", start_command))
    app.add_handler(CommandHandler("nftoken", nftoken_command))
    app.add_handler(CommandHandler("addacc", add_acc_command))
    app.add_handler(CommandHandler("stats", lambda u, c: c.bot.send_message(u.effective_chat.id, f"📊 Total Bot Users: {len(db_query('SELECT user_id FROM users', fetch='all'))}")))
    app.add_handler(CommandHandler("admin", lambda u, c: u.message.reply_text("Admin Panel", reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("⚙️ Open Admin Control", callback_data="admin_panel")]]))))
    app.add_handler(CallbackQueryHandler(button_callback))
    app.add_handler(MessageHandler(filters.TEXT & (~filters.COMMAND), handle_message))

    print("[+] Kudasai Keyless Netflix Bot is online with working /nftoken button routing!")
    app.run_polling()

if __name__ == "__main__":
    main()
