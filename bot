async def redeem_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    args = context.args
    if not args:
        await update.message.reply_text("❌ Usage: `/redeem <KEY>`")
        return
    key_input = args[0].strip()
    key_data = db_query("SELECT duration_hours, is_redeemed FROM keys WHERE key=?", (key_input,), "one")
    if not key_data or key_data[1] == 1:
        await update.message.reply_text("❌ Invalid or used key.")
        return
    db_query("UPDATE keys SET is_redeemed=1, redeemed_by=? WHERE key=?", (user.id, key_input))
    current_expiry = db_query("SELECT expiry FROM users WHERE user_id=?", (user.id,), "one")
    base_time = datetime.now()
    if current_expiry and current_expiry[0]:
        parsed_exp = datetime.fromisoformat(current_expiry[0])
        if parsed_exp > base_time: base_time = parsed_exp
    new_expiry = base_time + timedelta(hours=key_data[0])
    db_query("UPDATE users SET expiry=? WHERE user_id=?", (new_expiry.isoformat(), user.id))
    await update.message.reply_text(f"✅ Success! Active until: {new_expiry.strftime('%Y-%m-%d %H:%M')}")

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    user_data = db_query("SELECT is_banned FROM users WHERE user_id=?", (user.id,), "one")
    if user_data and user_data[0] == 1: return

    if update.message.document:
        doc = update.message.document
        file_obj = await context.bot.get_file(doc.file_id)
        byte_array = await file_obj.download_as_bytearray()
        try: file_content = byte_array.decode("utf-8", errors="ignore")
        except: file_content = str(byte_array)
        await process_accounts_with_native_engine(file_content.splitlines(), update.effective_chat.id, context)
        return

    text = update.message.text
    if text and not text.startswith("/"):
        await process_accounts_with_native_engine(text.splitlines(), update.effective_chat.id, context)

